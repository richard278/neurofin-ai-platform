APP_NAME=NeuroFin Forecast API
APP_ENV=development
APP_VERSION=0.1.0
API_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEFAULT_FORECAST_HORIZON=12
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/neurofin
TWELVE_DATA_API_KEY=replace-with-local-secret
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
MARKET_DATA_TIMEOUT_SECONDS=5
